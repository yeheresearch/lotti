diff --git a/lib/utils/portable_mode.dart b/lib/utils/portable_mode.dart
new file mode 100644
index 0000000000000000000000000000000000000000..6d335a75a325033a7b33f53bebf3d3d3fd5c4e74
--- /dev/null
+++ b/lib/utils/portable_mode.dart
@@ -0,0 +1,113 @@
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+import 'package:path_provider_windows/path_provider_windows.dart';
+import 'package:shared_preferences_platform_interface/shared_preferences_async_platform_interface.dart';
+import 'package:shared_preferences_platform_interface/shared_preferences_platform_interface.dart';
+import 'package:shared_preferences_windows/shared_preferences_windows.dart';
+
+const portableModeMarkerFileName = 'portable.mode';
+const portableDataDirectoryName = 'userdata';
+
+bool _portableModeActive = false;
+Directory? _portableDataDirectory;
+
+/// Whether this process is running from a marker-enabled Windows portable
+/// directory.
+bool get isPortableModeActive => _portableModeActive;
+
+/// The app-local data directory while [isPortableModeActive] is true.
+Directory? get portableDataDirectory => _portableDataDirectory;
+
+/// Redirects every path-provider storage class into the extracted program
+/// directory when `portable.mode` is next to the Windows executable.
+///
+/// This must run before logging, preferences, databases, secure storage, or
+/// any other service asks path_provider for an operating-system directory.
+void configurePortableMode() {
+  if (!Platform.isWindows) return;
+
+  final executableDirectory = p.dirname(Platform.resolvedExecutable);
+  final marker = File(p.join(executableDirectory, portableModeMarkerFileName));
+  if (!marker.existsSync()) return;
+
+  final dataDirectory = Directory(
+    p.join(executableDirectory, portableDataDirectoryName),
+  )..createSync(recursive: true);
+  for (final child in const ['cache', 'temp', 'exports']) {
+    Directory(p.join(dataDirectory.path, child)).createSync(recursive: true);
+  }
+
+  final portablePathProvider = PortablePathProviderPlatform(
+    dataRoot: dataDirectory.path,
+  );
+  PathProviderPlatform.instance = portablePathProvider;
+
+  // shared_preferences_windows 2.4.1 bypasses PathProviderPlatform.instance
+  // and constructs PathProviderWindows directly. Point both of its registered
+  // stores at the same adapter so window geometry, UI hints, and other simple
+  // preferences stay under userdata too.
+  final preferencesStore = SharedPreferencesStorePlatform.instance;
+  if (preferencesStore is SharedPreferencesWindows) {
+    // The locked plugin exposes path-provider injection only through this
+    // public testing seam; using it avoids forking or upgrading the package.
+    // ignore: invalid_use_of_visible_for_testing_member
+    preferencesStore.pathProvider = portablePathProvider;
+  }
+  final asyncPreferencesStore = SharedPreferencesAsyncPlatform.instance;
+  if (asyncPreferencesStore is SharedPreferencesAsyncWindows) {
+    // See the synchronous store explanation above.
+    // ignore: invalid_use_of_visible_for_testing_member
+    asyncPreferencesStore.pathProvider = portablePathProvider;
+  }
+
+  _portableDataDirectory = dataDirectory;
+  _portableModeActive = true;
+}
+
+/// Path-provider adapter used by the marker-enabled Windows package.
+///
+/// Downloads are deliberately redirected too: exports made through a path
+/// provider stay beside the application rather than leaking into the Windows
+/// profile. Platform-only external-storage calls are redirected for the same
+/// reason even though the Windows build does not normally use them.
+class PortablePathProviderPlatform extends PathProviderWindows {
+  PortablePathProviderPlatform({required String dataRoot})
+    : _dataRoot = p.normalize(dataRoot);
+
+  final String _dataRoot;
+
+  String get _cachePath => p.join(_dataRoot, 'cache');
+  String get _temporaryPath => p.join(_dataRoot, 'temp');
+  String get _downloadsPath => p.join(_dataRoot, 'exports');
+
+  @override
+  Future<String?> getApplicationSupportPath() async => _dataRoot;
+
+  @override
+  Future<String?> getApplicationDocumentsPath() async => _dataRoot;
+
+  @override
+  Future<String?> getLibraryPath() async => _dataRoot;
+
+  @override
+  Future<String?> getApplicationCachePath() async => _cachePath;
+
+  @override
+  Future<String?> getTemporaryPath() async => _temporaryPath;
+
+  @override
+  Future<String?> getDownloadsPath() async => _downloadsPath;
+
+  @override
+  Future<String?> getExternalStoragePath() async => _dataRoot;
+
+  @override
+  Future<List<String>?> getExternalCachePaths() async => [_cachePath];
+
+  @override
+  Future<List<String>?> getExternalStoragePaths({
+    StorageDirectory? type,
+  }) async => [_dataRoot];
+}
