diff --git a/test/utils/portable_mode_test.dart b/test/utils/portable_mode_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..65f9342afc940f10537919603bf367d3c1306179
--- /dev/null
+++ b/test/utils/portable_mode_test.dart
@@ -0,0 +1,37 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:lotti/utils/portable_mode.dart';
+import 'package:path/path.dart' as p;
+import 'package:path_provider_windows/path_provider_windows.dart';
+
+void main() {
+  test(
+    'portable path provider keeps every storage class under userdata',
+    () async {
+      final provider = PortablePathProviderPlatform(
+        dataRoot: r'D:\Lotti\userdata',
+      );
+
+      expect(provider, isA<PathProviderWindows>());
+      final paths = <String?>[
+        await provider.getApplicationSupportPath(),
+        await provider.getApplicationDocumentsPath(),
+        await provider.getLibraryPath(),
+        await provider.getApplicationCachePath(),
+        await provider.getTemporaryPath(),
+        await provider.getDownloadsPath(),
+        await provider.getExternalStoragePath(),
+        ...?await provider.getExternalCachePaths(),
+        ...?await provider.getExternalStoragePaths(),
+      ];
+
+      for (final path in paths) {
+        expect(
+          p.isWithin(r'D:\Lotti\userdata', path!) ||
+              p.equals(r'D:\Lotti\userdata', path),
+          isTrue,
+          reason: path,
+        );
+      }
+    },
+  );
+}
